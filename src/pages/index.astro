---
const bandName = 'I Feel More Like I Do Now Than I Ever Have';
const repetitions = Array.from({ length: 100 }, (_, i) => i);

// Placeholder: all 4 "sections" point at the same photo/text for now, while
// the parallax scroll mechanics get built out. Swap in real per-section
// images and content once they exist - the arrays just need to stay the
// same length as each other.
const SECTION_COUNT = 4;
const backgroundImages = Array.from({ length: SECTION_COUNT }, () => '/images/background.jpg');
const contentSets = Array.from({ length: SECTION_COUNT }, (_, i) => ({
	label: `This is content item ${i}`,
}));
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>IFMLIDNTIEH</title>
		<style define:vars={{ sectionCount: SECTION_COUNT }}>
			@font-face {
				font-family: 'Shabby';
				src: url('/fonts/Shabby.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
			}

			html, body {
				margin: 0;
			}

			body {
				/* Total scroll length is at least N viewport-heights (one per
				   section), regardless of how tall the backdrop text happens
				   to wrap to - if the text is taller, the page just grows to
				   fit it instead. */
				min-height: calc(var(--sectionCount) * 100vh);
			}

			.backdrop-text p {
				margin: 0;
				word-break: break-all;
				font-family: 'Shabby', sans-serif;
				font-size: clamp(20px, 6vw, 40px);
				font-weight: bold;
				text-transform: uppercase;
			}

			.backdrop-text p span {
				color: #88a;
				opacity: 0.5;
			}

			/* Permanent trait of the original 3rd instance only - stays even
			   after .active has moved on to a later instance. */
			.backdrop-text p span.origin {
				word-break: normal;
			}

			/* Dynamic "currently highlighted" state, moved between instances
			   by the scroll script below. Deliberately doesn't touch
			   word-break, so only .origin ever gets the word-break exception. */
			.backdrop-text p span.active {
				color: #fff;
				opacity: 1;
				text-shadow:
					0 0 4px rgba(0, 0, 0, 0.95),
					0 0 12px rgba(0, 0, 0, 0.9),
					0 0 28px rgba(0, 0, 0, 0.85),
					0 0 60px rgba(0, 0, 0, 0.75);
			}

			/* Layer 2: background images, stacked one per section, pinned to
			   the viewport and slid up by the parallax script at a quarter
			   of actual scroll speed. Sits behind the backdrop text via the
			   negative z-index. */
			.bg-image-layer {
				position: fixed;
				inset: 0;
				overflow: hidden;
				z-index: -1;
				background-color: #000;
			}

			.bg-image-track {
				will-change: transform;
			}

			.bg-image {
				width: 100%;
				height: 100vh;
				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
			}

			/* Layer 3: content item sets, pinned near the bottom of the
			   viewport. Doesn't physically move - sets crossfade in place as
			   the parallax script updates their opacity based on scroll
			   progress through each section. */
			.content-overlay {
				position: fixed;
				top: 34vh;
				bottom: 5vh;
				left: 5%;
				right: 5%;
				z-index: 2;
				pointer-events: none;
			}

			.content-set {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
			}

			.content-item {
				width: 70%;
				height: 70%;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 24px;
				color: #fff;
				font-family: sans-serif;
				font-size: clamp(18px, 3vw, 28px);
				background-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.45) 60%, transparent 100%);
			}
		</style>
	</head>
	<body>
		<div class="backdrop-text" aria-hidden="true">
			<p>{repetitions.map((i) => (
				<>
					<span class:list={['backdrop-span', { origin: i === 2, active: i === 0 }]} data-index={i}>{bandName}</span>
					{i < repetitions.length - 1 && ' '}
				</>
			))}</p>
		</div>

		<div class="bg-image-layer" aria-hidden="true">
			<div class="bg-image-track">
				{backgroundImages.map((src) => (
					<div class="bg-image" style={`background-image: url(${src});`} />
				))}
			</div>
		</div>

		<div class="content-overlay">
			{contentSets.map((set, i) => (
				<div class="content-set" data-index={i}>
					<div class="content-item">{set.label}</div>
				</div>
			))}
		</div>

		<script>
			// A single symmetric rule, applied on scroll in either direction
			// and on initial load: an instance "qualifies" to be active once
			// its top sits at least one line-height below the viewport top
			// (i.e. it isn't within a line-height of the edge). Active is
			// always the earliest instance that qualifies, so the white text
			// hands off before it ever gets close to touching the top edge.
			// The original 3rd instance keeps its own `.origin` class
			// (word-break: normal) permanently - this only ever moves `.active`.
			// Estimated line-height in px, used only for the advance-buffer
			// math below - not read from the DOM/CSS, so it can't fight with
			// or get thrown off by the actual line-height CSS controls.
			// Tune this directly if the buffer feels too tight or too loose.
			const ESTIMATED_LINE_HEIGHT_PX = 50;

			const spans = Array.from(document.querySelectorAll<HTMLElement>('.backdrop-span'));
			let activeIndex = spans.findIndex((span) => span.classList.contains('active'));

			function setActiveIndex(nextIndex: number) {
				spans[activeIndex].classList.remove('active');
				activeIndex = nextIndex;
				spans[activeIndex].classList.add('active');
			}

			function qualifies(el: HTMLElement) {
				return el.getBoundingClientRect().top >= ESTIMATED_LINE_HEIGHT_PX;
			}

			function updateActive() {
				if (activeIndex < 0) return;

				while (activeIndex < spans.length - 1 && !qualifies(spans[activeIndex])) {
					setActiveIndex(activeIndex + 1);
				}

				while (activeIndex > 0 && qualifies(spans[activeIndex - 1])) {
					setActiveIndex(activeIndex - 1);
				}
			}

			updateActive();
			window.addEventListener('scroll', updateActive, { passive: true });
			window.addEventListener('resize', updateActive);
		</script>

		<script>
			// Parallax layers 2 and 3. One continuous scroll progress value
			// drives both: `progress` is scrollY measured in units of one
			// section height (100vh), so progress === i means section i
			// exactly fills the viewport.
			//
			// Layer 2 (background images) slides at a quarter of actual
			// scroll speed - it's a transform on the whole stacked track,
			// not tied to section boundaries at all.
			//
			// Layer 3 (content sets) doesn't move; each set's opacity is a
			// triangular function of `progress` that peaks at 1 when its own
			// section is exactly centered and crosses 0.5 at the midpoint
			// between two sections, giving a linear crossfade.
			const IMAGE_PARALLAX_FACTOR = 0.25;

			const track = document.querySelector<HTMLElement>('.bg-image-track');
			const contentSetEls = Array.from(document.querySelectorAll<HTMLElement>('.content-set'));

			function updateParallax() {
				const scrollY = window.scrollY;
				const sectionHeightPx = window.innerHeight;

				if (track) {
					track.style.transform = `translateY(-${scrollY * IMAGE_PARALLAX_FACTOR}px)`;
				}

				const progress = scrollY / sectionHeightPx;
				contentSetEls.forEach((set, i) => {
					set.style.opacity = String(Math.max(0, 1 - Math.abs(progress - i)));
				});
			}

			updateParallax();
			window.addEventListener('scroll', updateParallax, { passive: true });
			window.addEventListener('resize', updateParallax);
		</script>
	</body>
</html>
