---
import { getCollection, render } from 'astro:content';
import { unified, type MarkdownRenderer } from '@astrojs/markdown-remark';
import remarkBreaks from 'remark-breaks';
import feelingsListRaw from '../content/about/feelings.list?raw';
import whatListRaw from '../content/about/what.list?raw';
import namesListRaw from '../content/about/names.list?raw';

const bandName = 'I Feel More Like I Do Now Than I Ever Have';
const repetitions = Array.from({ length: 400 }, (_, i) => i);

// One background image per section, named for the section rather than
// index-prefixed - order here is what determines each section's index (0 is
// Home, with no nav link - just the top of the site).
const backgroundImages = [
	'/images/backgrounds/Home.jpg',
	'/images/backgrounds/Video.jpg',
	'/images/backgrounds/Events.jpg',
	'/images/backgrounds/Poems.jpg',
	'/images/backgrounds/About.jpg',
];

// Blank lines in the .list files are just visual separators between
// entries, not data - drop them along with surrounding whitespace.
function parseList(raw: string): string[] {
	return raw
		.split('\n')
		.map((line) => line.trim())
		.filter((line) => line.length > 0);
}

const feelingsList = parseList(feelingsListRaw);
const whatList = parseList(whatListRaw);
const namesList = parseList(namesListRaw);

function stripParagraphTag(html: string): string {
	return html.replace(/^<p>/, '').replace(/<\/p>\s*$/, '');
}

// Builds the swapped-in HTML for a "{fieldName}" line (e.g. "*band* is...
// {feelings}") in About's markdown - used for both {feelings} and {what}.
// The whole line (not just the placeholder) gets rebuilt as a CSS grid with
// two copies stacked in the same cell: the live one, and an invisible
// "sizer" using the list's longest-by-character-count line instead (an
// approximation of "longest when rendered" - not exact, but it only needs
// to reserve space generously, not precisely). The grid cell's height
// becomes the taller of the two, so swapping the live line's text never
// changes this paragraph's height (and doesn't push the paragraphs below it
// up and down) - this needs the whole line, not just a span around the
// placeholder, since the prefix text ("... is... ") plus the field's text is
// what actually wraps across lines together.
async function buildDynamicFieldLine(bodySource: string, fieldName: string, list: string[], renderer: MarkdownRenderer) {
	const [, prefixSrc = '', suffixSrc = ''] = bodySource.match(new RegExp(`^(.*)\\{${fieldName}\\}(.*)$`, 'm')) ?? [];
	const prefixHtml = prefixSrc ? stripParagraphTag((await renderer.render(prefixSrc)).code) : '';
	const suffixHtml = suffixSrc ? stripParagraphTag((await renderer.render(suffixSrc)).code) : '';
	const sizerLine = list.reduce((longest, line) => (line.length > longest.length ? line : longest));
	// The prefix is re-rendered on its own above, so the trailing space
	// before the placeholder in the markdown source doesn't survive
	// (CommonMark trims trailing whitespace at a paragraph's end) - add it
	// back explicitly here.
	const html = `<p class="dynamic-field-wrapper" data-field="${fieldName}"><span class="dynamic-field-layer">${prefixHtml} <span class="dynamic-field" data-field="${fieldName}">${list[0]}</span>${suffixHtml}</span><span class="dynamic-field-layer dynamic-field-sizer" aria-hidden="true">${prefixHtml} ${sizerLine}${suffixHtml}</span></p>`;
	return html;
}

// Static tail appended after the shuffled names in {names-and-weirdos} -
// always the same text, but re-appended (and so included in the fade) on
// every reshuffle rather than living in the surrounding markdown as its own
// static text, per the user's request.
const NAMES_SUFFIX = ' and an associated cabal of lovely, creative weirdos.';

// Single markdown file under src/content/about (see content.config.ts).
// Its body has three placeholders - {feelings}, {what}, and
// {names-and-weirdos} - that get swapped here for spans carrying their
// step-0 value, rather than being left to the normal collection renderer.
// That's so the client-side script below can target them by class and cycle
// their text on a timer. Rendering the swapped-in markdown ourselves (same
// processor/plugins as astro.config.mjs) is what lets those placeholders be
// replaced before markdown turns them into HTML, instead of after.
const aboutEntry = (await getCollection('about'))[0];
const aboutRenderer = await unified({ remarkPlugins: [remarkBreaks] }).createRenderer({});

const feelingsLineHtml = await buildDynamicFieldLine(aboutEntry.body, 'feelings', feelingsList, aboutRenderer);
const whatLineHtml = await buildDynamicFieldLine(aboutEntry.body, 'what', whatList, aboutRenderer);

const aboutMarkdownWithFields = aboutEntry.body
	.replace(/^.*\{feelings\}.*$/m, feelingsLineHtml)
	.replace(/^.*\{what\}.*$/m, whatLineHtml)
	.replace(
		'{names-and-weirdos}',
		`<span class="dynamic-field" data-field="names-and-weirdos">${namesList.join(', ')}${NAMES_SUFFIX}</span>`,
	);
const { code: aboutHtml } = await aboutRenderer.render(aboutMarkdownWithFields);

// Each poem is its own markdown file under src/content/poems (see
// content.config.ts) - title and display order come from frontmatter,
// body is rendered markdown (remark-breaks, configured in astro.config.mjs,
// turns the poems' single newlines into <br>s instead of CommonMark's
// default of collapsing them into one run-on line).
const poemEntries = (await getCollection('poems')).sort((a, b) => a.data.order - b.data.order);
const poemsData = await Promise.all(
	poemEntries.map(async (entry) => {
		const { Content } = await render(entry);
		return { title: entry.data.title, Content };
	}),
);

// Same shape/mechanism as the poems above - one markdown file per event
// under src/content/events (see content.config.ts).
const eventEntries = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
const eventsData = await Promise.all(
	eventEntries.map(async (entry) => {
		const { Content } = await render(entry);
		return { title: entry.data.title, Content };
	}),
);

// Content sets, one "page" each - index matches the background image order
// above (Home=0 has no page/link; Video=1, Events=2, Poems=3, About=4).
const pageSets = [
	{ label: 'Video', index: 1, layout: 'video', youtubeId: 'xoUr47_bM5I', title: 'I Feel More Like I Do Now Than I Ever Have - Live in a Basement - August 2026' },
	{ label: 'Events', index: 2, layout: 'tabs', selectAriaLabel: 'Select an event', items: eventsData, reversed: true },
	{ label: 'Poems', index: 3, layout: 'tabs', selectAriaLabel: 'Select a poem', items: poemsData },
	{ label: 'About', index: 4, layout: 'tattered-text', html: aboutHtml },
];
const contentSets = pageSets;

// Nav links embedded in the first 8 (0-7) backdrop-text occurrences, each in
// the gap between two of them (gap i sits between occurrence i and i+1, so
// there are 7 gaps: 0-6). Rules: a link's gap can't be immediately next to
// another link's gap... actually it always isn't - two different gaps are
// never touching since there's always at least one occurrence between them -
// and a link's gap can't be immediately next to whichever occurrence is
// currently the actual-title (its 1-2 bordering gaps are off limits).
// Used for every nav link's href (e.g. "#video") - plain lowercase/hyphenated
// labels, so clicking a section link leaves a shareable /#<slug> URL.
function slugify(label: string): string {
	return label.toLowerCase().replace(/\s+/g, '-');
}

const navLinks = pageSets.map((set) => ({ label: set.label, targetIndex: set.index, slug: slugify(set.label) }));
const ACTUAL_TITLE_STATIC_INDEX = 2;
// Static (no-JS) fallback placement - avoids gaps 1 and 2, the two bordering
// ACTUAL_TITLE_STATIC_INDEX. Gap 4 is left empty, same as in the original
// example's spacing.
const STATIC_GAP_ASSIGNMENT: Record<number, (typeof navLinks)[number]> = {
	0: navLinks[0],
	3: navLinks[1],
	5: navLinks[2],
	6: navLinks[3],
};
const NAV_WINDOW_SIZE = 8; // occurrences 0-7, gaps 0-6

// Background image layer (see the parallax script): the whole stacked track
// slides up at this fraction of actual scroll speed.
const IMAGE_PARALLAX_FACTOR = 0.25;

// Content set i peaks (fully opaque) at the same scroll position where
// background image i exactly fills the viewport. Image i sits at i*100vh in
// the untransformed track, and the track has moved up by scrollY *
// IMAGE_PARALLAX_FACTOR px, so image i fully fills the viewport when
// scrollY = i*100vh / IMAGE_PARALLAX_FACTOR - i.e. i * (1 / factor)
// viewport-heights of scroll apart.
const CONTENT_PEAK_SPACING = 1 / IMAGE_PARALLAX_FACTOR;
// One-sided fade duration, in units of one viewport-height of scroll. Equal
// to the full peak spacing, so a set's fade spans the entire gap to each
// neighboring peak: section N is at 0% exactly when N-1 or N+1 is centered,
// and two adjacent sections are each at 50% at the midpoint between them -
// a continuous crossfade, not a fade-out/pause/fade-in.
const CONTENT_FADE_HALF_WIDTH = CONTENT_PEAK_SPACING;
// About's {feelings}/{what} fields (see below) each hold their current line
// for (word count / 2) seconds before swapping to a new random one - longer
// phrases stay up longer. {names-and-weirdos} instead reshuffles on a flat interval
// (NAMES_FADE_INTERVAL_MS), regardless of word count. Either way the swap
// fades out/in across fadeDurationMs, which must stay shorter than both and
// match the CSS transition-duration on .dynamic-field.
const FADE_DURATION_MS = 600;
const NAMES_FADE_INTERVAL_MS = 10000;
// Highest content-set index (4, since they're 1-4) - used for the scroll
// length below. Not contentSets.length, since that's now 4 while indices
// run 1-4 rather than 0-3.
const MAX_CONTENT_INDEX = Math.max(...contentSets.map((set) => set.index));
// Total scroll length, in viewport-heights: the last content set's peak,
// plus exactly one more viewport. That "+1" isn't padding - it's the
// minimum a page can be taller than a scroll position for that position to
// be reachable at all (max scrollY is documentHeight - viewportHeight), so
// without it the browser's native scroll limit would land one viewport
// short of the peak and About could never actually reach full opacity. The
// page's actual bottom (see .backdrop-text below) IS this length, so it
// doubles as "the page can't be scrolled past About fully arriving."
const TOTAL_SCROLL_VIEWPORTS = MAX_CONTENT_INDEX * CONTENT_PEAK_SPACING + 1;

// The two colors used throughout the nav/title system (actual-title,
// inline nav-links, section-nav), named once here instead of as separate
// hex literals in every rule - swapping their roles (as happened once
// already) is then a one-line change, not a hunt across the stylesheet.
const COLOR_PRIMARY = '#fff';
const COLOR_SECONDARY = '#c4ad7a';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>IFMLIDNTIEH</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant&display=swap" rel="stylesheet" />
		<style define:vars={{ totalScrollViewports: TOTAL_SCROLL_VIEWPORTS, colorPrimary: COLOR_PRIMARY, colorSecondary: COLOR_SECONDARY }}>
			@font-face {
				font-family: 'Shabby';
				src: url('/fonts/Shabby.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
			}

			html, body {
				margin: 0;
			}

			/* Default for everything except the backdrop band-name text (and
			   the nav styled to match it - see .backdrop-text/.section-nav
			   below, which explicitly set Shabby instead). */
			body {
				font-family: 'Cormorant', serif;
				font-size: 20px;
			}

			/* This - not a min-height on body - is what sets the total
			   scroll length (see TOTAL_SCROLL_VIEWPORTS above for why it's
			   peak + 1, not just peak). A fixed height (rather than sizing
			   to the wrapped text's natural height, which varies with
			   viewport width) plus overflow: hidden clips any excess
			   repetitions instead of letting them stretch the page past
			   this point - without it, the page would scroll however far
			   past About as the text happens to wrap to, instead of
			   stopping right where it's fully arrived. backdrop-text is
			   the last thing in body now (no footer after it), so this is
			   also the page's actual total height. */
			.backdrop-text {
				height: calc(var(--totalScrollViewports) * 100vh);
				overflow: hidden;
			}

			.backdrop-text p {
				margin: 0;
				word-break: break-all;
				font-family: 'Shabby', sans-serif;
				font-size: clamp(20px, 6vw, 40px);
				font-weight: bold;
				text-transform: uppercase;
			}

			.backdrop-text p span {
				color: #88a;
				opacity: 0.5;
			}

			/* .nav-gap is also a span under .backdrop-text p - without this,
			   it (and the nav-link button inside it) would inherit the
			   dimming above, washing out the button's own styling. */
			.backdrop-text p span.nav-gap {
				opacity: 1;
			}

			/* The "actual title" - the one real instance of the band name
			   amid all the decorative repetitions. Reads on its own words
			   (not broken mid-word like the rest) and is highlighted white. */
			.backdrop-text p span.actual-title {
				word-break: normal;
				color: var(--colorPrimary);
				opacity: 1;
				text-shadow:
					0 0 4px rgba(0, 0, 0, 0.95),
					0 0 12px rgba(0, 0, 0, 0.9),
					0 0 28px rgba(0, 0, 0, 0.85),
					0 0 60px rgba(0, 0, 0, 0.75);
			}

			/* Nav links, embedded among the first 8 backdrop-text occurrences
			   (see the frontmatter/script). Styled like .actual-title - same
			   word-break exception, same general glow - but gold instead of
			   white, with a lighter shadow. */
			.backdrop-text .nav-link {
				font: inherit;
				text-transform: inherit;
				word-break: normal;
				color: var(--colorSecondary);
				background: none;
				border: none;
				padding: 0;
				margin: 0 0.3em;
				text-decoration: none;
				cursor: pointer;
				transition: color 0.2s ease;
				text-shadow:
					0 0 3px rgba(0, 0, 0, 0.85),
					0 0 9px rgba(0, 0, 0, 0.75),
					0 0 18px rgba(0, 0, 0, 0.65),
					0 0 36px rgba(0, 0, 0, 0.5);
			}

			.backdrop-text .nav-link:hover {
				color: var(--colorPrimary);
			}

/* Full section nav, floating independently (not part of the
			   backdrop text flow) along the bottom. Same look as the inline
			   nav-links (font, color, shadow, hover), but its own smaller
			   size - the giant backdrop-text size would be absurd for a
			   small corner UI element. Hidden on Home itself and faded in by
			   the script below once scrolled past it. */
			.section-nav {
				position: fixed;
				bottom: 24px;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				justify-content: center;
				gap: 1.5em;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}

			.section-nav.is-visible {
				opacity: 1;
				pointer-events: auto;
			}

			.section-nav-link {
				font-family: 'Shabby', sans-serif;
				font-weight: bold;
				text-transform: uppercase;
				/* Same basis (vw) as the backdrop text's clamp(20px, 6vw,
				   40px) - between its size and the smaller one this used to
				   be, so it tracks if that one is ever retuned. */
				font-size: clamp(17px, 4vw, 30px);
				word-break: normal;
				color: var(--colorSecondary);
				background: none;
				border: none;
				padding: 0;
				text-decoration: none;
				cursor: pointer;
				transition: color 0.2s ease;
				text-shadow:
					0 0 3px rgba(0, 0, 0, 0.85),
					0 0 9px rgba(0, 0, 0, 0.75),
					0 0 18px rgba(0, 0, 0, 0.65),
					0 0 36px rgba(0, 0, 0, 0.5);
			}

			.section-nav-link:hover,
			/* Current section indicator - whichever link's section is
			   nearest the current scroll position, ties going to the
			   earlier one (see the script below). Same as hover. */
			.section-nav-link.is-current {
				color: var(--colorPrimary);
			}

			/* Five labels in one row no longer fit at the desktop sizing
			   once the viewport gets this narrow - continues the same
			   clamp down to a lower floor (17px, the desktop floor,
			   matches right at the 700px boundary, so there's no jump)
			   and tightens the gap to match, rather than wrapping or
			   letting it run off the sides. */
			@media (max-width: 700px) {
				.section-nav {
					gap: 0.6em;
				}

				.section-nav-link {
					font-size: clamp(10px, 3.2vw, 17px);
				}
			}

			/* Layer 2: background images, stacked one per section, pinned to
			   the viewport and slid up by the parallax script at a quarter
			   of actual scroll speed. Sits behind the backdrop text via the
			   negative z-index. */
			.bg-image-layer {
				position: fixed;
				inset: 0;
				overflow: hidden;
				z-index: -1;
				/* Only visible once scrolled past the last background image,
				   where the track runs out and this shows through beneath it. */
				background-color: #2d323b;
			}

			.bg-image-track {
				will-change: transform;
			}

			.bg-image {
				width: 100%;
				height: 100vh;
				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
			}

			/* Layer 3: content item sets, pinned near the bottom of the
			   viewport. Doesn't physically move - sets crossfade in place as
			   the parallax script updates their opacity based on scroll
			   progress through each section. */
			.content-overlay {
				position: fixed;
				/* vmin, not vh/%, so the margin reads as equal on every
				   side - except the bottom, padded out further to stay
				   clear of the floating section-nav bar. */
				inset: 5vmin 5vmin calc(5vmin + 90px) 5vmin;
				z-index: 2;
				pointer-events: none;
			}

			.content-set {
				position: absolute;
				inset: 0;
				opacity: 0;
			}

			/* Full-bleed opaque black box with readable body copy, shared by
			   the About page and the tabs layout (Poems, Events) - both its
			   title rectangles and its selected-item display box - rather
			   than one of the big centered-text placeholder cards. The
			   jagged border is a
			   ::before so the SVG filter distorts only the decorative edge,
			   not the actual text. The box itself stays overflow:visible so
			   that ::before's negative inset (it bleeds outside the box)
			   never gets clipped - scrolling (needed when content runs
			   longer than the box) instead happens on a separate inner
			   .tattered-box-scroll wrapper. */
			.tattered-box {
				position: relative;
				width: 100%;
				height: 100%;
				box-sizing: border-box;
				background: #000;
				color: #fff;
				line-height: 1.6;
				text-align: left;
			}

			/* :global() - every .tattered-box's actual text content (About,
			   each poem) is now markdown rendered via a separate Content
			   component, so its <p> tags never carry this component's own
			   scoped data-astro-cid attribute and a plain scoped selector
			   would silently never match them (see the tab-body rules
			   below for the same situation). */
			.tattered-box :global(p) {
				margin: 0 0 1em;
			}

			/* About's {feelings}/{what} lines (see index.astro frontmatter) are
			   each rebuilt as a single-cell grid with their live text and a
			   hidden same-styled "sizer" overlapping in that cell - the cell's
			   height becomes whichever of the two is taller, so changing the
			   live text never changes that paragraph's height. */
			.tattered-box :global(.dynamic-field-wrapper) {
				display: grid;
			}
			.tattered-box :global(.dynamic-field-layer) {
				grid-area: 1 / 1;
			}
			.tattered-box :global(.dynamic-field-sizer) {
				visibility: hidden;
			}
			/* Duration here must match FADE_DURATION_MS in index.astro's
			   frontmatter, which times each field's text swap to land while
			   this is fully faded out - applies to all three dynamic fields
			   (feelings, what, names-and-weirdos). */
			.tattered-box :global(.dynamic-field) {
				transition: opacity 0.6s ease;
			}

			.tattered-box::before {
				content: '';
				position: absolute;
				inset: -6px;
				border: 3px solid #fff;
				filter: url(#tattered-edge);
				pointer-events: none;
			}

			.tattered-box-scroll {
				width: 100%;
				height: 100%;
				overflow-y: auto;
				box-sizing: border-box;
				padding: 6% 7%;
			}

			.tattered-box .tab-body {
				display: none;
			}

			.tattered-box .tab-body.is-active {
				display: block;
			}

			/* :global() on the markdown-generated tags (p/code/pre/a) -
			   they're rendered by the poem's own Content component, not
			   this one, so they never receive this component's scoped
			   data-astro-cid attribute and a plain scoped selector would
			   silently never match them. .tab-body itself stays scoped,
			   since that wrapper div IS part of this component's markup. */

			/* Inline code only - scoped to p so it doesn't also paint a
			   translucent background behind every line of a fenced code
			   block, which already gets its own background from Shiki. */
			.tattered-box .tab-body :global(p code) {
				background: rgba(255, 255, 255, 0.12);
				padding: 0.1em 0.3em;
				border-radius: 3px;
			}

			.tattered-box .tab-body :global(pre) {
				padding: 0.75em 1em;
				border-radius: 4px;
				overflow-x: auto;
			}

			.tattered-box .tab-body :global(a) {
				color: var(--colorSecondary);
			}

			/* Tabs layout (Poems, Events): a stack of small tattered-box
			   title rectangles on the left (click to select), and one
			   tattered-box on the right showing the selected item's
			   content - each box gets its own independent tattered edge
			   via its own ::before, no internal dividers between them,
			   just a gap. */
			.tabs-layout {
				display: flex;
				width: 100%;
				height: 100%;
				gap: 4%;
			}

			/* Events only - titles/picker after the content instead of
			   before it. order: -1 on the display box alone (rather than
			   reordering the other two) puts it first regardless of
			   flex-direction, so this one rule covers both the desktop row
			   (content left, titles right) and the mobile column (content
			   on top, dropdown below) cases below. */
			.tabs-layout.reversed .tabs-display {
				order: -1;
			}

			.tabs-titles {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 4%;
				width: 30%;
				height: 100%;
			}

			.tab-title-box {
				flex: 0 0 20%;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 6% 7%;
				border: none;
				font: inherit;
				cursor: pointer;
				transition: color 0.2s ease;
			}

			.tab-title-box:hover,
			.tab-title-box.is-selected {
				color: var(--colorSecondary);
			}

			.tab-title-box.is-selected {
				font-weight: bold;
			}

			.tabs-display {
				flex: 1;
				/* Flex items default to min-height: auto on the main axis,
				   which refuses to shrink below content size - in the
				   narrow-viewport column layout below, that silently
				   defeats .tattered-box-scroll's overflow-y: auto, growing
				   this box to fit all the poem text instead of clipping/
				   scrolling it within the available space. */
				min-height: 0;
				height: 100%;
			}

			/* Dropdown stand-in for .tabs-titles on narrow viewports (see
			   the media query below) - hidden otherwise. A native <select>
			   doesn't reliably render ::before/::after (it's a replaced
			   element in most browsers), so the tattered-box edge goes on
			   this wrapper instead, with the <select> itself just filling
			   it. Explicit height: auto overrides the height: 100% it'd
			   otherwise inherit from .tattered-box - without it, flex: 0 0
			   auto's "auto" basis resolves to that inherited 100% instead
			   of the one-line content height it's meant to be. Padding is
			   em-based (not the rest of the box's %, which is relative to
			   width) so the control's height stays "one line + padding"
			   regardless of how wide the dropdown ends up. */
			.tab-select-wrapper {
				display: none;
				width: 100%;
				height: auto;
				padding: 0.5em 0.8em;
			}

			.tab-select {
				display: block;
				width: 100%;
				border: none;
				background: none;
				color: inherit;
				font: inherit;
				cursor: pointer;
			}

			/* Too narrow for two columns (e.g. mobile) - stack into one
			   column instead: the title picker collapses from a stack of
			   rectangles into a single dropdown, with the selected item's
			   contents below it. */
			@media (max-width: 700px) {
				.tabs-layout {
					flex-direction: column;
				}

				.tabs-titles {
					display: none;
				}

				.tab-select-wrapper {
					display: block;
					flex: 0 0 auto;
				}
			}

			/* Page 2: embedded video, capped to a sane max width and kept at
			   16:9 regardless of the (currently square-ish) content-overlay
			   box it sits in. */
			.content-set[data-layout='video'] .video-box {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.content-set[data-layout='video'] iframe {
				width: 100%;
				max-width: 960px;
				aspect-ratio: 16 / 9;
				border: none;
			}

		</style>
	</head>
	<body>
		<div class="backdrop-text">
			<p>{repetitions.map((i) => (
				<>
					<span class:list={[{ 'actual-title': i === ACTUAL_TITLE_STATIC_INDEX }]} data-index={i} aria-hidden="true">{bandName}</span>
					{i < repetitions.length - 1 && ' '}
					{i < NAV_WINDOW_SIZE - 1 && (
						<span class="nav-gap" data-gap={i}>
							{STATIC_GAP_ASSIGNMENT[i] && (
								<a
									class="nav-link"
									href={`#${STATIC_GAP_ASSIGNMENT[i].slug}`}
									data-target-index={STATIC_GAP_ASSIGNMENT[i].targetIndex}
								>
									{STATIC_GAP_ASSIGNMENT[i].label}
								</a>
							)}
						</span>
					)}
				</>
			))}</p>
		</div>

		<svg width="0" height="0" style="position: absolute;" aria-hidden="true" focusable="false">
			<filter id="tattered-edge">
				<feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="7" result="noise" />
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>

		<div class="bg-image-layer" aria-hidden="true">
			<div class="bg-image-track">
				{backgroundImages.map((src) => (
					<div class="bg-image" style={`background-image: url(${src});`} />
				))}
			</div>
		</div>

		<div class="content-overlay">
			{contentSets.map((set) => (
				<div class="content-set" id={slugify(set.label)} data-index={set.index} data-layout={set.layout}>
					{set.layout === 'tattered-text' && (
						<div class="tattered-box">
							<div class="tattered-box-scroll" set:html={set.html} />
						</div>
					)}
					{set.layout === 'tabs' && (
						<div class:list={['tabs-layout', { reversed: set.reversed }]}>
							<div class="tabs-titles">
								{set.items.map((item, i) => (
									<button type="button" class:list={['tattered-box', 'tab-title-box', { 'is-selected': i === 0 }]} data-tab-index={i}>
										{item.title}
									</button>
								))}
							</div>
							<div class="tattered-box tab-select-wrapper">
								<select class="tab-select" aria-label={set.selectAriaLabel}>
									{set.items.map((item, i) => (
										<option value={i} selected={i === 0}>{item.title}</option>
									))}
								</select>
							</div>
							<div class="tattered-box tabs-display">
								<div class="tattered-box-scroll">
									{set.items.map((item, i) => (
										<div class:list={['tab-body', { 'is-active': i === 0 }]} data-tab-index={i}>
											<item.Content />
										</div>
									))}
								</div>
							</div>
						</div>
					)}
					{set.layout === 'video' && (
						<div class="video-box">
							<iframe
								src={`https://www.youtube.com/embed/${set.youtubeId}`}
								title={set.title}
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
							/>
						</div>
					)}
				</div>
			))}
		</div>

		<nav class="section-nav">
			<a class="section-nav-link" href="#home" data-target-index="0">Home</a>
			{pageSets.map((set) => (
				<a class="section-nav-link" href={`#${slugify(set.label)}`} data-target-index={set.index}>{set.label}</a>
			))}
		</nav>

		<script>
			// Hard-coded in the markup to index 2 (actual-title) and a fixed
			// gap assignment (nav links), so the page reads and navigates
			// fine with no JS. With JS, both get re-randomized on every load:
			// the actual title moves to one of the first 7 (0-6) occurrences,
			// and the 4 nav links move to 4 of the 7 gaps between the first 8
			// (0-7) occurrences, avoiding whichever gap(s) now border the
			// actual title.
			const ACTUAL_TITLE_RANDOM_RANGE = 7; // 0-6
			const GAP_COUNT = 7; // 0-6, between occurrences 0-7

			function shuffle<T>(items: T[]): T[] {
				const result = items.slice();
				for (let i = result.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[result[i], result[j]] = [result[j], result[i]];
				}
				return result;
			}

			// Only the band-title occurrences have data-index - the nav-gap
			// spans use data-gap instead, so this doesn't pick those up too.
			const occurrences = Array.from(document.querySelectorAll<HTMLElement>('.backdrop-text span[data-index]'));
			const currentActual = occurrences.find((span) => span.classList.contains('actual-title'));
			const newActualIndex = Math.floor(Math.random() * ACTUAL_TITLE_RANDOM_RANGE);
			const newActual = occurrences[newActualIndex];

			if (currentActual && newActual && currentActual !== newActual) {
				currentActual.classList.remove('actual-title');
				newActual.classList.add('actual-title');
			}

			const forbiddenGaps = new Set([newActualIndex - 1, newActualIndex].filter((g) => g >= 0 && g < GAP_COUNT));
			const allowedGaps: number[] = [];
			for (let g = 0; g < GAP_COUNT; g++) {
				if (!forbiddenGaps.has(g)) allowedGaps.push(g);
			}

			const navLinkAnchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
			navLinkAnchors.forEach((anchor) => anchor.remove());

			const chosenGaps = shuffle(allowedGaps).slice(0, navLinkAnchors.length);
			const shuffledButtons = shuffle(navLinkAnchors);

			chosenGaps.forEach((gap, i) => {
				document.querySelector(`.nav-gap[data-gap="${gap}"]`)?.appendChild(shuffledButtons[i]);
			});

			// Tabs layout (Poems, Events): picking an item - via a title
			// rectangle (wide viewports) or the dropdown that replaces them
			// (narrow viewports, see the media query above) - swaps which
			// item's content is shown in the display box, and keeps
			// whichever picker is currently hidden in sync too, so
			// switching viewport width mid-visit doesn't leave it stale.
			// Scoped per .tabs-layout instance - there's one of these per
			// page (Poems, Events), and matching by class name alone
			// (instead of querying within each instance) would both only
			// ever wire up the first dropdown found in the whole document
			// and cross-apply title-button clicks in one tabs layout to
			// the other's same-index item.
			document.querySelectorAll<HTMLElement>('.tabs-layout').forEach((layout) => {
				const titleButtons = Array.from(layout.querySelectorAll<HTMLButtonElement>('.tab-title-box'));
				const select = layout.querySelector<HTMLSelectElement>('.tab-select');
				const bodies = Array.from(layout.querySelectorAll<HTMLElement>('.tab-body'));

				function selectTab(index: string) {
					titleButtons.forEach((b) => b.classList.toggle('is-selected', b.getAttribute('data-tab-index') === index));
					bodies.forEach((body) => {
						body.classList.toggle('is-active', body.getAttribute('data-tab-index') === index);
					});
					if (select) select.value = index;
				}

				titleButtons.forEach((button) => {
					button.addEventListener('click', () => selectTab(button.getAttribute('data-tab-index') ?? '0'));
				});

				select?.addEventListener('change', () => selectTab(select.value));
			});
		</script>

		<script
			define:vars={{
				imageParallaxFactor: IMAGE_PARALLAX_FACTOR,
				contentPeakSpacing: CONTENT_PEAK_SPACING,
				contentFadeHalfWidth: CONTENT_FADE_HALF_WIDTH,
				feelingsList,
				whatList,
				namesList,
				fadeDurationMs: FADE_DURATION_MS,
				namesFadeIntervalMs: NAMES_FADE_INTERVAL_MS,
				namesSuffix: NAMES_SUFFIX,
			}}
		>
			// Parallax layers 2 and 3. One continuous scroll progress value
			// drives both: `progress` is scrollY measured in units of one
			// viewport-height of scroll.
			//
			// Layer 2 (background images) slides at a quarter of actual
			// scroll speed - it's a transform on the whole stacked track,
			// not tied to section boundaries at all.
			//
			// Layer 3 (content sets) doesn't move; each set's opacity is a
			// triangular function of `progress` that peaks at 1 when
			// progress === i * contentPeakSpacing, and reaches 0 exactly
			// contentFadeHalfWidth before/after that - so one set fully
			// fades out before the next fades in, rather than crossfading
			// directly into it.
			const track = document.querySelector('.bg-image-track');
			const contentSetEls = Array.from(document.querySelectorAll('.content-set'));
			const sectionNav = document.querySelector('.section-nav');
			const sectionNavLinks = Array.from(document.querySelectorAll('.section-nav-link'));

			// About's {feelings}/{what}/{names-and-weirdos} fields (see index.astro
			// frontmatter, which renders a static step-0 value into these
			// spans server-side - just a placeholder until this script picks
			// something random). All three fade out, swap, and fade back in
			// on their own independent, out-of-sync timers - the opacity dip
			// is a CSS transition (see .dynamic-field below) timed to match
			// fadeDurationMs, with the text swapped at the bottom of the dip
			// while it's invisible.
			function shuffle(items) {
				const result = items.slice();
				for (let i = result.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[result[i], result[j]] = [result[j], result[i]];
				}
				return result;
			}

			// Names: a random order on load, then reshuffled on a flat
			// interval (unlike feelings/what below, which hold longer
			// phrases longer) - it's a fixed set of words, not a list of
			// options, so word count isn't a meaningful way to pace it.
			// namesSuffix is static text, but re-appended (and so faded)
			// alongside every reshuffle rather than living outside the span.
			function setupNamesField(fieldName, list, suffix, intervalMs) {
				const span = document.querySelector(`.dynamic-field[data-field="${fieldName}"]`);
				if (!span) return;

				let current = shuffle(list).join(', ') + suffix;
				span.textContent = current;

				setInterval(() => {
					span.style.opacity = '0';
					setTimeout(() => {
						// Exclude the current order so every swap is a visible
						// change, not just a shorter set of orders to pick from.
						let next = current;
						if (list.length > 1) {
							while (next === current) {
								next = shuffle(list).join(', ') + suffix;
							}
						}
						current = next;
						span.textContent = current;
						span.style.opacity = '1';
					}, fadeDurationMs);
				}, intervalMs);
			}
			setupNamesField('names-and-weirdos', namesList, namesSuffix, namesFadeIntervalMs);

			// Feelings/what: a random line on load, then fade to a different
			// random line after holding it for (word count / 2) seconds -
			// longer phrases stay up longer.
			function setupFadingField(fieldName, list) {
				const span = document.querySelector(`.dynamic-field[data-field="${fieldName}"]`);
				if (!span) return;

				let currentIndex = Math.floor(Math.random() * list.length);
				span.textContent = list[currentIndex];

				function scheduleFade() {
					const wordCount = list[currentIndex].trim().split(/\s+/).length;
					const holdDurationMs = (wordCount / 2) * 1000;
					setTimeout(() => {
						span.style.opacity = '0';
						setTimeout(() => {
							// Exclude the current line so every swap is a visible
							// change, not just a shorter list to pick from.
							let nextIndex = currentIndex;
							if (list.length > 1) {
								while (nextIndex === currentIndex) {
									nextIndex = Math.floor(Math.random() * list.length);
								}
							}
							currentIndex = nextIndex;
							span.textContent = list[currentIndex];
							span.style.opacity = '1';
							scheduleFade();
						}, fadeDurationMs);
					}, holdDurationMs);
				}
				scheduleFade();
			}
			setupFadingField('feelings', feelingsList);
			setupFadingField('what', whatList);

			// The {feelings}/{what} paragraphs each already reserve enough
			// height for their own longest line (see buildDynamicFieldLine in
			// the frontmatter and the grid-stack CSS below) - this just takes
			// the larger of those two independently-computed heights and
			// applies it to both, so neither paragraph is taller than the
			// other depending on which field happens to need more room.
			// Re-run on resize since the wrap (and so the required height)
			// depends on viewport width.
			function equalizeDynamicFieldHeights() {
				const wrappers = Array.from(document.querySelectorAll('.dynamic-field-wrapper[data-field="feelings"], .dynamic-field-wrapper[data-field="what"]'));
				if (wrappers.length < 2) return;
				wrappers.forEach((el) => {
					el.style.minHeight = '';
				});
				const maxHeight = Math.max(...wrappers.map((el) => el.offsetHeight));
				wrappers.forEach((el) => {
					el.style.minHeight = `${maxHeight}px`;
				});
			}
			equalizeDynamicFieldHeights();
			window.addEventListener('resize', equalizeDynamicFieldHeights);

			function updateParallax() {
				const scrollY = window.scrollY;
				const sectionHeightPx = window.innerHeight;

				if (track) {
					track.style.transform = `translateY(-${scrollY * imageParallaxFactor}px)`;
				}

				const progress = scrollY / sectionHeightPx;
				contentSetEls.forEach((set) => {
					// Content sets are indexed 1-4 (not 0-3), so this reads
					// each set's own data-index rather than its position in
					// contentSetEls.
					const index = Number(set.getAttribute('data-index'));
					const peak = index * contentPeakSpacing;
					const opacity = Math.max(0, 1 - Math.abs(progress - peak) / contentFadeHalfWidth);
					set.style.opacity = String(opacity);
					// Every set is stacked at the same position regardless of
					// opacity, so without this, an invisible set could still
					// steal clicks/selection from the one actually on screen.
					// The video set gets a much higher bar: its embedded
					// player is clickable (and audible) the instant pointer
					// events are on, not just visually present like a div of
					// text is, so it shouldn't arm until mostly faded in.
					const pointerThreshold = set.getAttribute('data-layout') === 'video' ? 0.75 : 0;
					set.style.pointerEvents = opacity > pointerThreshold ? 'auto' : 'none';
				});

				// Hidden until the first content section (index 1, Video) has
				// reached 50% opacity on its way up - visible from there on.
				sectionNav?.classList.toggle('is-visible', progress >= contentPeakSpacing / 2);

				// Current section: whichever peak is nearest, ties going to
				// the earlier (lower-index) section - each section "owns" the
				// scroll range up to and including its own midpoint with the
				// next one, so Math.ceil (not .round) is what gives ties to
				// the lower side.
				const currentIndex = Math.max(0, Math.ceil(progress / contentPeakSpacing - 0.5));
				sectionNavLinks.forEach((link) => {
					const index = Number(link.getAttribute('data-target-index'));
					link.classList.toggle('is-current', index === currentIndex);
				});
			}

			// Table-of-contents links are real anchors (href="#video" etc) so
			// the URL bar reflects the current section and it's shareable -
			// but since every section is a fixed-position overlay rather than
			// a document position, there's nothing at that id for the browser
			// to natively scroll to. So clicking one only updates the hash by
			// itself; the scroll itself is still this computed jump,
			// recomputed at click time so a resize since load doesn't throw
			// it off.
			document.querySelectorAll('[data-target-index]').forEach((link) => {
				link.addEventListener('click', () => {
					const targetIndex = Number(link.getAttribute('data-target-index'));
					const top = targetIndex * contentPeakSpacing * window.innerHeight;
					window.scrollTo({ top, behavior: 'smooth' });
				});
			});

			// Landing directly on a section's URL (e.g. /#video) needs the
			// same jump, just instant rather than smooth, and has to happen
			// before the first updateParallax() below so that call already
			// reflects the right section instead of flashing Home first.
			const initialHash = window.location.hash.replace(/^#/, '');
			if (initialHash) {
				const initialLink = document.querySelector(`[data-target-index][href="#${initialHash}"]`);
				if (initialLink) {
					const targetIndex = Number(initialLink.getAttribute('data-target-index'));
					window.scrollTo({ top: targetIndex * contentPeakSpacing * window.innerHeight });
				}
			}

			updateParallax();
			window.addEventListener('scroll', updateParallax, { passive: true });
			window.addEventListener('resize', updateParallax);
		</script>
	</body>
</html>
