---
const bandName = 'I Feel More Like I Do Now Than I Ever Have';
const repetitions = Array.from({ length: 400 }, (_, i) => i);

// Placeholder images/copy while the parallax scroll mechanics get built out.
// Swap in real per-section images and copy once they exist.
const backgroundImages = [
	'/images/backgrounds/0_swirl.jpg',
	'/images/backgrounds/1_dancer.jpg',
	'/images/backgrounds/2_crowd.jpg',
	'/images/backgrounds/3_lyrics.jpg',
	'/images/backgrounds/4_swirl.jpg',
];

const loremSnippets = [
	'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
	'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
	'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.',
	'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum.',
	'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia.',
	'Curabitur pretium tincidunt lacus, et facilisis vel enim nec placerat.',
	'Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere.',
	'Praesent commodo cursus magna, vel scelerisque nisl consectetur et.',
	'Nullam quis risus eget urna mollis ornare vel eu leo.',
	'Maecenas sed diam eget risus varius blandit sit amet non magna.',
];
let loremIndex = 0;
function nextLorem() {
	const text = loremSnippets[loremIndex % loremSnippets.length];
	loremIndex += 1;
	return text;
}

const pageOneParagraphs = [
	'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
	'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
	'Curabitur pretium tincidunt lacus, et facilisis vel enim nec placerat. Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae; Praesent commodo cursus magna, vel scelerisque nisl consectetur et.',
];

// Content sets, one "page" each, indexed 1-4 (not 0-3) - index 0 is
// deliberately unused, so background image 0 plays as a plain intro with no
// content overlay. Nav links to these live in the backdrop text itself now,
// not in a separate table-of-contents overlay.
const pageSets = [
	{ layout: 'tattered-text', paragraphs: pageOneParagraphs },
	{ layout: 'video', youtubeId: 'dQw4w9WgXcQ', title: 'Placeholder video - swap for a real one later' },
	{ layout: 'columns-3', items: Array.from({ length: 3 }, () => ({ text: nextLorem() })) },
	{ layout: 'rows-3', items: Array.from({ length: 3 }, () => ({ text: nextLorem() })) },
];
const contentSets = pageSets.map((set, i) => ({ ...set, index: i + 1 }));

// Nav links embedded in the first 8 (0-7) backdrop-text occurrences, each in
// the gap between two of them (gap i sits between occurrence i and i+1, so
// there are 7 gaps: 0-6). Rules: a link's gap can't be immediately next to
// another link's gap... actually it always isn't - two different gaps are
// never touching since there's always at least one occurrence between them -
// and a link's gap can't be immediately next to whichever occurrence is
// currently the actual-title (its 1-2 bordering gaps are off limits).
const navLinks = [
	{ label: 'About', targetIndex: 1 },
	{ label: 'Video', targetIndex: 2 },
	{ label: 'Events', targetIndex: 3 },
	{ label: 'Lyrics', targetIndex: 4 },
];
const ACTUAL_TITLE_STATIC_INDEX = 2;
// Static (no-JS) fallback placement - avoids gaps 1 and 2, the two bordering
// ACTUAL_TITLE_STATIC_INDEX. Gap 4 is left empty, same as in the original
// example's spacing.
const STATIC_GAP_ASSIGNMENT: Record<number, (typeof navLinks)[number]> = {
	0: navLinks[0],
	3: navLinks[1],
	5: navLinks[2],
	6: navLinks[3],
};
const NAV_WINDOW_SIZE = 8; // occurrences 0-7, gaps 0-6

// Background image layer (see the parallax script): the whole stacked track
// slides up at this fraction of actual scroll speed.
const IMAGE_PARALLAX_FACTOR = 0.25;

// Content set i peaks (fully opaque) at the same scroll position where
// background image i exactly fills the viewport. Image i sits at i*100vh in
// the untransformed track, and the track has moved up by scrollY *
// IMAGE_PARALLAX_FACTOR px, so image i fully fills the viewport when
// scrollY = i*100vh / IMAGE_PARALLAX_FACTOR - i.e. i * (1 / factor)
// viewport-heights of scroll apart.
const CONTENT_PEAK_SPACING = 1 / IMAGE_PARALLAX_FACTOR;
// One-sided fade duration, in units of one viewport-height of scroll. Kept
// well under half the peak spacing, so there's a brief flat pause at zero
// opacity between one set finishing its fade-out and the next starting its
// fade-in, rather than them touching or overlapping.
const CONTENT_FADE_HALF_WIDTH = 1.5;
// Highest content-set index (4, since they're 1-4) - used for the min-height
// formula below. Not contentSets.length, since that's now 4 while indices
// run 1-4 rather than 0-3.
const MAX_CONTENT_INDEX = Math.max(...contentSets.map((set) => set.index));
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>IFMLIDNTIEH</title>
		<style define:vars={{ maxContentIndex: MAX_CONTENT_INDEX, contentPeakSpacing: CONTENT_PEAK_SPACING, contentFadeHalfWidth: CONTENT_FADE_HALF_WIDTH }}>
			@font-face {
				font-family: 'Shabby';
				src: url('/fonts/Shabby.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
			}

			html, body {
				margin: 0;
			}

			body {
				/* Total scroll length is at least enough to reach the last
				   content set's peak and let it fade back out, regardless of
				   how tall the backdrop text happens to wrap to - if the text
				   is taller, the page just grows to fit it instead. */
				min-height: calc((var(--maxContentIndex) * var(--contentPeakSpacing) + var(--contentFadeHalfWidth)) * 100vh);
			}

			.backdrop-text p {
				margin: 0;
				word-break: break-all;
				font-family: 'Shabby', sans-serif;
				font-size: clamp(20px, 6vw, 40px);
				font-weight: bold;
				text-transform: uppercase;
			}

			.backdrop-text p span {
				color: #88a;
				opacity: 0.5;
			}

			/* .nav-gap is also a span under .backdrop-text p - without this,
			   it (and the nav-link button inside it) would inherit the
			   dimming above, washing out the button's own styling. */
			.backdrop-text p span.nav-gap {
				opacity: 1;
			}

			/* The "actual title" - the one real instance of the band name
			   amid all the decorative repetitions. Reads on its own words
			   (not broken mid-word like the rest) and is highlighted white. */
			.backdrop-text p span.actual-title {
				word-break: normal;
				color: #cbcbbf;
				opacity: 1;
				text-shadow:
					0 0 4px rgba(0, 0, 0, 0.95),
					0 0 12px rgba(0, 0, 0, 0.9),
					0 0 28px rgba(0, 0, 0, 0.85),
					0 0 60px rgba(0, 0, 0, 0.75);
			}

			/* Nav links, embedded among the first 8 backdrop-text occurrences
			   (see the frontmatter/script). Styled like .actual-title - same
			   word-break exception, same general glow - but a step down:
			   off-white instead of pure white, lighter shadow. */
			.backdrop-text .nav-link {
				font: inherit;
				text-transform: inherit;
				word-break: normal;
				color: #fff;
				background: none;
				border: none;
				padding: 0;
				margin: 0 0.3em;
				cursor: pointer;
				transition: color 0.2s ease;
				text-shadow:
					0 0 3px rgba(0, 0, 0, 0.85),
					0 0 9px rgba(0, 0, 0, 0.75),
					0 0 18px rgba(0, 0, 0, 0.65),
					0 0 36px rgba(0, 0, 0, 0.5);
			}

			.backdrop-text .nav-link:hover {
				color: #c4ad7a;
			}

			/* No background/border of its own - just sits on whatever's
			   behind it (the page background color, once scrolled past the
			   last background image), so running off the last image reads
			   as "we've reached the footer," not "we ran out of images." */
			.site-footer {
				position: relative;
				z-index: 1;
				padding: 24px 16px;
				color: #ff0;
				font-family: monospace;
				font-size: 14px;
				text-align: center;
			}

			/* Layer 2: background images, stacked one per section, pinned to
			   the viewport and slid up by the parallax script at a quarter
			   of actual scroll speed. Sits behind the backdrop text via the
			   negative z-index. */
			.bg-image-layer {
				position: fixed;
				inset: 0;
				overflow: hidden;
				z-index: -1;
				/* Only visible once scrolled past the last background image,
				   where the track runs out and this shows through beneath it. */
				background-color: #2d323b;
			}

			.bg-image-track {
				will-change: transform;
			}

			.bg-image {
				width: 100%;
				height: 100vh;
				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
			}

			/* Layer 3: content item sets, pinned near the bottom of the
			   viewport. Doesn't physically move - sets crossfade in place as
			   the parallax script updates their opacity based on scroll
			   progress through each section. */
			.content-overlay {
				position: fixed;
				/* vmin, not vh/%, so the margin reads as equal on every side
				   regardless of viewport aspect ratio. */
				inset: 5vmin;
				z-index: 2;
				pointer-events: none;
			}

			.content-set {
				position: absolute;
				inset: 0;
				opacity: 0;
			}

			.content-items {
				width: 100%;
				height: 100%;
				display: grid;
				gap: 4%;
			}

			.content-set[data-layout='grid-2x2'] .content-items {
				grid-template-columns: repeat(2, 1fr);
				grid-template-rows: repeat(2, 1fr);
			}

			.content-set[data-layout='single'] .content-items {
				grid-template-columns: 1fr;
				grid-template-rows: 1fr;
			}

			.content-set[data-layout='single'] .content-item {
				width: 70%;
				height: 70%;
				margin: auto;
			}

			.content-set[data-layout='columns-3'] .content-items {
				grid-template-columns: repeat(3, 1fr);
				grid-template-rows: 1fr;
			}

			.content-set[data-layout='rows-3'] .content-items {
				grid-template-columns: 1fr;
				grid-template-rows: repeat(3, 1fr);
			}

			/* Page 1: full-bleed opaque black box with readable body copy,
			   rather than one of the big centered-text placeholder cards.
			   The jagged border is a ::before so the SVG filter distorts
			   only the decorative edge, not the actual paragraph text. */
			.content-set[data-layout='tattered-text'] .tattered-box {
				position: relative;
				width: 100%;
				height: 100%;
				box-sizing: border-box;
				padding: 6% 7%;
				background: #000;
				color: #fff;
				font-family: sans-serif;
				font-size: 1rem;
				line-height: 1.6;
				text-align: left;
			}

			.content-set[data-layout='tattered-text'] .tattered-box p {
				margin: 0 0 1em;
			}

			.content-set[data-layout='tattered-text'] .tattered-box::before {
				content: '';
				position: absolute;
				inset: -6px;
				border: 3px solid #fff;
				filter: url(#tattered-edge);
				pointer-events: none;
			}

			/* Page 2: embedded video, capped to a sane max width and kept at
			   16:9 regardless of the (currently square-ish) content-overlay
			   box it sits in. */
			.content-set[data-layout='video'] .video-box {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.content-set[data-layout='video'] iframe {
				width: 100%;
				max-width: 960px;
				aspect-ratio: 16 / 9;
				border: none;
			}

			.content-item {
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 24px;
				color: #fff;
				font-family: sans-serif;
				font-size: clamp(16px, 2.4vw, 24px);
				background-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.45) 60%, transparent 100%);
				/* pointer-events is inherited from .content-set (see below) -
				   not set here, since every set is stacked at the same inset:0
				   position regardless of opacity, and only the currently-
				   visible one should actually be selectable/clickable. */
			}
		</style>
	</head>
	<body>
		<div class="backdrop-text">
			<p>{repetitions.map((i) => (
				<>
					<span class:list={[{ 'actual-title': i === ACTUAL_TITLE_STATIC_INDEX }]} data-index={i} aria-hidden="true">{bandName}</span>
					{i < repetitions.length - 1 && ' '}
					{i < NAV_WINDOW_SIZE - 1 && (
						<span class="nav-gap" data-gap={i}>
							{STATIC_GAP_ASSIGNMENT[i] && (
								<button type="button" class="nav-link" data-target-index={STATIC_GAP_ASSIGNMENT[i].targetIndex}>{STATIC_GAP_ASSIGNMENT[i].label}</button>
							)}
						</span>
					)}
				</>
			))}</p>
		</div>

		<footer class="site-footer">
			<p>
				⚠️ PLACEHOLDER FOOTER ⚠️ — &copy; 2026 I Feel More Like I Do Now Than I Ever Have. All rights reserved (probably). Replace this with real copyright/contact/links later.
			</p>
		</footer>

		<svg width="0" height="0" style="position: absolute;" aria-hidden="true" focusable="false">
			<filter id="tattered-edge">
				<feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="7" result="noise" />
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>

		<div class="bg-image-layer" aria-hidden="true">
			<div class="bg-image-track">
				{backgroundImages.map((src) => (
					<div class="bg-image" style={`background-image: url(${src});`} />
				))}
			</div>
		</div>

		<div class="content-overlay">
			{contentSets.map((set) => (
				<div class="content-set" data-index={set.index} data-layout={set.layout}>
					{set.layout === 'tattered-text' && (
						<div class="tattered-box">
							{set.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					)}
					{set.layout === 'video' && (
						<div class="video-box">
							<iframe
								src={`https://www.youtube.com/embed/${set.youtubeId}`}
								title={set.title}
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
							/>
						</div>
					)}
					{set.layout !== 'tattered-text' && set.layout !== 'video' && (
						<div class="content-items">
							{set.items.map((item) => (
								<div class="content-item">{item.text}</div>
							))}
						</div>
					)}
				</div>
			))}
		</div>

		<script>
			// Hard-coded in the markup to index 2 (actual-title) and a fixed
			// gap assignment (nav links), so the page reads and navigates
			// fine with no JS. With JS, both get re-randomized on every load:
			// the actual title moves to one of the first 7 (0-6) occurrences,
			// and the 4 nav links move to 4 of the 7 gaps between the first 8
			// (0-7) occurrences, avoiding whichever gap(s) now border the
			// actual title.
			const ACTUAL_TITLE_RANDOM_RANGE = 7; // 0-6
			const GAP_COUNT = 7; // 0-6, between occurrences 0-7

			function shuffle<T>(items: T[]): T[] {
				const result = items.slice();
				for (let i = result.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[result[i], result[j]] = [result[j], result[i]];
				}
				return result;
			}

			// Only the band-title occurrences have data-index - the nav-gap
			// spans use data-gap instead, so this doesn't pick those up too.
			const occurrences = Array.from(document.querySelectorAll<HTMLElement>('.backdrop-text span[data-index]'));
			const currentActual = occurrences.find((span) => span.classList.contains('actual-title'));
			const newActualIndex = Math.floor(Math.random() * ACTUAL_TITLE_RANDOM_RANGE);
			const newActual = occurrences[newActualIndex];

			if (currentActual && newActual && currentActual !== newActual) {
				currentActual.classList.remove('actual-title');
				newActual.classList.add('actual-title');
			}

			const forbiddenGaps = new Set([newActualIndex - 1, newActualIndex].filter((g) => g >= 0 && g < GAP_COUNT));
			const allowedGaps: number[] = [];
			for (let g = 0; g < GAP_COUNT; g++) {
				if (!forbiddenGaps.has(g)) allowedGaps.push(g);
			}

			const navLinkButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-link'));
			navLinkButtons.forEach((button) => button.remove());

			const chosenGaps = shuffle(allowedGaps).slice(0, navLinkButtons.length);
			const shuffledButtons = shuffle(navLinkButtons);

			chosenGaps.forEach((gap, i) => {
				document.querySelector(`.nav-gap[data-gap="${gap}"]`)?.appendChild(shuffledButtons[i]);
			});
		</script>

		<script define:vars={{ imageParallaxFactor: IMAGE_PARALLAX_FACTOR, contentPeakSpacing: CONTENT_PEAK_SPACING, contentFadeHalfWidth: CONTENT_FADE_HALF_WIDTH }}>
			// Parallax layers 2 and 3. One continuous scroll progress value
			// drives both: `progress` is scrollY measured in units of one
			// viewport-height of scroll.
			//
			// Layer 2 (background images) slides at a quarter of actual
			// scroll speed - it's a transform on the whole stacked track,
			// not tied to section boundaries at all.
			//
			// Layer 3 (content sets) doesn't move; each set's opacity is a
			// triangular function of `progress` that peaks at 1 when
			// progress === i * contentPeakSpacing, and reaches 0 exactly
			// contentFadeHalfWidth before/after that - so one set fully
			// fades out before the next fades in, rather than crossfading
			// directly into it.
			const track = document.querySelector('.bg-image-track');
			const contentSetEls = Array.from(document.querySelectorAll('.content-set'));

			function updateParallax() {
				const scrollY = window.scrollY;
				const sectionHeightPx = window.innerHeight;

				if (track) {
					track.style.transform = `translateY(-${scrollY * imageParallaxFactor}px)`;
				}

				const progress = scrollY / sectionHeightPx;
				contentSetEls.forEach((set) => {
					// Content sets are indexed 1-4 (not 0-3), so this reads
					// each set's own data-index rather than its position in
					// contentSetEls.
					const index = Number(set.getAttribute('data-index'));
					const peak = index * contentPeakSpacing;
					const opacity = Math.max(0, 1 - Math.abs(progress - peak) / contentFadeHalfWidth);
					set.style.opacity = String(opacity);
					// Every set is stacked at the same position regardless of
					// opacity, so without this, an invisible set could still
					// steal clicks/selection from the one actually on screen.
					set.style.pointerEvents = opacity > 0 ? 'auto' : 'none';
				});
			}

			// Table-of-contents buttons jump straight to a set's peak scroll
			// position, recomputed at click time so a resize since load
			// doesn't throw it off.
			document.querySelectorAll('[data-target-index]').forEach((button) => {
				button.addEventListener('click', () => {
					const targetIndex = Number(button.getAttribute('data-target-index'));
					const top = targetIndex * contentPeakSpacing * window.innerHeight;
					window.scrollTo({ top, behavior: 'smooth' });
				});
			});

			updateParallax();
			window.addEventListener('scroll', updateParallax, { passive: true });
			window.addEventListener('resize', updateParallax);
		</script>
	</body>
</html>
